generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("ADMIN") // ADMIN, FINANCE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id                            String    @id @default(uuid())
  name                          String
  cpf                           String    @unique
  type                          String // PJ, CLT or VOLUNTARIO
  role                          String
  baseSalary                    Float
  profilePhotoUrl               String?
  startDate                     DateTime?
  eatsAtSchool                  Boolean   @default(false)
  transportDaily                Float?
  gasAssistance                 Float?
  pixKey                        String?
  paymentMethod                 String    @default("PIX") // PIX or TRANSFER
  bankName                      String?
  accountType                   String?
  agency                        String?
  accountNumber                 String?
  recurringDeductions           Float     @default(0)
  temporaryDeductions           Float     @default(0)
  temporaryDeductionsDesc       String?
  temporaryDeductionsExpiration String?
  hourlyRate                    Float?
  cestaBasica                   Float?
  isAulista                     Boolean   @default(false)
  salaryAdvance                 Float     @default(0)
  active                        Boolean   @default(true)
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  payrolls            Payroll[]
  advances            PayrollAdvance[]
  rescisoes           Rescisao[]
  employeeSubjects    EmployeeSubject[]
  teachingAssignments TeachingAssignment[]
  salaryAdjustments   SalaryAdjustment[]
}

model Subject {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeeSubjects    EmployeeSubject[]
  teachingAssignments TeachingAssignment[]
}

model EmployeeSubject {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  subjectId  String
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([employeeId, subjectId])
}

model TeachingAssignment {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  weekday     Int // 1=segunda, 7=domingo
  startTime   String
  endTime     String
  classGroup  String?
  lessonStart Int?
  lessonEnd   Int?
  fullDay     Boolean  @default(false)
  hours       Float
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SalaryAdjustment {
  id              String   @id @default(uuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  effectiveDate   DateTime
  previousSalary  Float
  newSalary       Float
  adjustmentValue Float
  notes           String?
  createdAt       DateTime @default(now())

  @@index([employeeId, effectiveDate])
}

model Payroll {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  month Int // 1 a 12
  year  Int // Ex: 2026

  baseSalary         Float
  workingDays        Int?
  transportTotal     Float?
  absences           Int    @default(0)
  absenceDeduction   Float  @default(0)
  absencesVT         Int    @default(0)
  transportDeduction Float  @default(0)
  otherDeductions    Float  @default(0)
  bonuses            Float  @default(0)
  grossEarnings      Float  @default(0)
  inssDeduction      Float  @default(0)
  irrfDeduction      Float  @default(0)
  fgtsValue          Float  @default(0)
  salaryAdvance      Float  @default(0)
  hoursAulista       Float?

  netTotal Float
  status   String @default("PENDING") // PENDING, PAID

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, month, year])
}

model PayrollAdvance {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  month  Int
  year   Int
  amount Float

  status String    @default("PENDING") // PENDING | PAID
  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, month, year])
}

model FinancialTransaction {
  id          String   @id @default(uuid())
  title       String
  type        String // INCOME or EXPENSE
  amount      Float
  category    String
  date        DateTime
  status      String   @default("PAID") // PENDING, PAID
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contract {
  id         String    @id @default(uuid())
  clientName String
  document   String
  title      String
  content    String
  status     String    @default("DRAFT") // DRAFT, ACTIVE, EXPIRED
  startDate  DateTime
  endDate    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Rescisao {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  month Int
  year  Int

  tipoRescisao String
  dataAdmissao DateTime
  dataDemissao DateTime
  avisoPrevio  String

  saldoSalario       Float @default(0)
  decimoTerceiroProp Float @default(0)
  decimoTerceiroInd  Float @default(0)
  feriasProp         Float @default(0)
  feriasInd          Float @default(0)
  tercoFeriasProp    Float @default(0)
  tercoFeriasInd     Float @default(0)
  feriasVencidas     Float @default(0)
  avisoPrevioIndeniz Float @default(0)
  fgtsRescisorio     Float @default(0)
  multaFgts          Float @default(0)
  inss               Float @default(0)
  inss13             Float @default(0)
  irrf               Float @default(0)

  totalBruto   Float  @default(0)
  totalLiquido Float  @default(0)
  status       String @default("PENDING") // PENDING | PAID

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, month, year], name: "rescisao_identifier")
}
